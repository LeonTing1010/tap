{
  "id": {
    "site": "algolia",
    "name": "hn-search"
  },
  "description": "HN Algolia search for 'tap' (golden-replay fixture for Layer 2). Different upstream + response shape from hn/top — paginated hits-array with rich metadata.",
  "observe": [
    {
      "op": "fetch",
      "url": "https://hn.algolia.com/api/v1/search?query=tap&hitsPerPage=20",
      "method": "GET",
      "format": "json",
      "save": "body",
      "expect": "$count($result.hits) > 0 and $exists($result.hits[0].objectID) and $exists($result.hits[0].title) and $exists($result.hits[0].author)"
    }
  ],
  "return": "$observe.body.hits.{ 'objectID': objectID, 'title': title, 'author': author, 'points': points, 'num_comments': num_comments }",
  "source_url": "https://hn.algolia.com/api/v1/search?query=tap&hitsPerPage=20",
  "source_intent": "HN Algolia search results for query 'tap'"
}
