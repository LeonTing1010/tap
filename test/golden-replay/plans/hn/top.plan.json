{
  "id": {
    "site": "hn",
    "name": "top"
  },
  "description": "list of HN top story IDs (golden-replay fixture for Layer 2)",
  "observe": [
    {
      "op": "fetch",
      "url": "https://hacker-news.firebaseio.com/v0/topstories.json",
      "method": "GET",
      "format": "json",
      "save": "body",
      "expect": "$count($result) > 10 and $type($result[0]) = \"number\""
    }
  ],
  "return": "$observe.body",
  "source_url": "https://hacker-news.firebaseio.com/v0/topstories.json",
  "source_intent": "list of HN top story IDs"
}
