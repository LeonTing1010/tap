      "sizes": ["400x400"],
      "mimeType": "image/png"
    }
  ],
  "repository": {
    "url": "https://github.com/LeonTing1010/tap",
    "source": "github"
  },
  "version": "0.27.0",
  "packages": [
    {
      "registryType": "npm",
