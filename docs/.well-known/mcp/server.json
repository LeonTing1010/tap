    },
    {
      "registryType": "pypi",
      "identifier": "taprun",
      "version": "0.27.0",
      "transport": { "type": "stdio" },
      "runtimeArguments": [
        { "type": "positional", "value": "mcp" },
        { "type": "positional", "value": "stdio" }
      ]
    }
  ],
