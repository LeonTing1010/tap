{
  "@context": [
    "http://www.w3.org/ns/anno.jsonld",
    "https://taprun.dev/ns/tap-v1"
  ],
  "@type": "Annotation",
  "id": "https://taprun.dev/taps/github/trending",
  "motivation": "tap:executing",
  "target": "https://taprun.dev/taps/github/trending",
  "body": {
    "type": "tap:ExecutionPlan",
    "site": "github",
    "name": "trending",
    "intent": "read",
    "description": "GitHub trending repositories - Get GitHub repos created in the last N days with minimum stars, filtered to AI/SaaS/devtool niches via topic and description keyword matching. Supply-side signal for solo builder category emergence.",
    "columns": ["slug", "description", "stars", "language", "topics", "created_at", "url"],
    "args": {
      "days": {
        "type": "int",
        "default": 7,
        "description": "Lookback window in days"
      },
      "min_stars": {
        "type": "int",
        "default": 5,
        "description": "Minimum stars to include"
      },
      "per_page": {
        "type": "int",
        "default": 50,
        "description": "Maximum results from API"
      }
    },
    "health": {
      "min_rows": 3,
      "non_empty": ["slug", "description"]
    }
  },
  "seeAlso": [
    "https://github.com/LeonTing1010/tap-skills/blob/main/showcase/github/trending.tap.js",
    "https://taprun.dev/taps/github/trending.html"
  ]
}
