  "body": {
    "type": "tap:ExecutionPlan",
    "site": "xiaohongshu",
    "name": "search",
    "intent": "read",
    "description": "Xiaohongshu (Little Red Book) notes search - Search for notes and get detailed information including title, author, likes, comments, collects, shares, tags, description, note type, URL, note ID, and xsec_token. Extracted from SSR-rendered page for subsequent operations.",
    "columns": ["title", "user", "likes", "comments", "collects", "shares", "tags", "desc", "type", "url", "noteId", "xsec_token"],
    "args": {
      "keyword": {
        "type": "string",
        "description": "Search keyword"
      }
    },
    "health": {
      "min_rows": 5,
      "non_empty": ["title", "noteId"]
    }
  },
