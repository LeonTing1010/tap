{
  "@context": [
    "http://www.w3.org/ns/anno.jsonld",
    "https://taprun.dev/ns/tap-v1"
  ],
  "@type": "Annotation",
  "id": "https://taprun.dev/taps/weibo/hot",
  "motivation": "tap:executing",
  "target": "https://taprun.dev/taps/weibo/hot",
  "body": {
    "type": "tap:ExecutionPlan",
    "site": "weibo",
    "name": "hot",
    "intent": "read",
    "description": "Weibo hot search - Real-time trending topics from Weibo (Chinese Twitter), including rank, topic, tag, heat value, and URL. Extracted from SSR-rendered table, supports public anonymous access.",
    "columns": ["rank", "title", "tag", "hot", "url"],
    "args": {
      "limit": {
        "type": "int",
        "default": 50,
        "description": "Maximum number of items to return"
      }
    },
    "health": {
      "min_rows": 20,
      "non_empty": ["title"]
    }
  },
  "seeAlso": [
    "https://github.com/LeonTing1010/tap-skills/blob/main/showcase/weibo/hot.tap.js",
    "https://taprun.dev/taps/weibo/hot.html"
  ]
}
