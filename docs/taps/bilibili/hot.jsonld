{
  "@context": [
    "http://www.w3.org/ns/anno.jsonld",
    "https://taprun.dev/ns/tap-v1"
  ],
  "@type": "Annotation",
  "id": "https://taprun.dev/taps/bilibili/hot",
  "motivation": "tap:executing",
  "target": "https://taprun.dev/taps/bilibili/hot",
  "body": {
    "type": "tap:ExecutionPlan",
    "site": "bilibili",
    "name": "hot",
    "intent": "read",
    "description": "Bilibili trending videos - Get trending videos from Bilibili ranking, including title, author, views, danmaku count, likes, coins, favorites, comments, duration, publish date, bvid, and URL. Extracted from SSR-rendered ranking page to avoid API rate limits.",
    "columns": ["title", "author", "views", "danmaku", "likes", "coins", "favorites", "comments", "duration", "pubdate", "bvid", "url"],
    "args": {
      "limit": {
        "type": "int",
        "default": 50,
        "description": "Maximum number of videos to return"
      }
    },
    "health": {
      "min_rows": 10,
      "non_empty": ["title", "bvid"]
    }
  },
  "seeAlso": [
    "https://github.com/LeonTing1010/tap-skills/blob/main/showcase/bilibili/hot.tap.js",
    "https://taprun.dev/taps/bilibili/hot.html"
  ]
}
