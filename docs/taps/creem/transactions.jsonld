{
  "@context": [
    "http://www.w3.org/ns/anno.jsonld",
    "https://taprun.dev/ns/tap-v1"
  ],
  "@type": "Annotation",
  "id": "https://taprun.dev/taps/creem/transactions",
  "motivation": "tap:executing",
  "target": "https://taprun.dev/taps/creem/transactions",
  "body": {
    "type": "tap:ExecutionPlan",
    "site": "creem",
    "name": "transactions",
    "intent": "read",
    "description": "List recent Creem transactions (payments)",
    "columns": [
      "amount",
      "status",
      "description",
      "customer",
      "date"
    ],
    "args": {
      "key": {
        "type": "string",
        "required": true,
        "description": "Creem API key"
      }
    },
    "health": {
      "min_rows": 1,
      "requires_auth": true
    }
  },
  "seeAlso": [
    "https://github.com/LeonTing1010/tap-skills/blob/main/community/creem/transactions.tap.json",
    "https://taprun.dev/taps/creem/transactions.html"
  ]
}
