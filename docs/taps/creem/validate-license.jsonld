{
  "@context": [
    "http://www.w3.org/ns/anno.jsonld",
    "https://taprun.dev/ns/tap-v1"
  ],
  "@type": "Annotation",
  "id": "https://taprun.dev/taps/creem/validate-license",
  "motivation": "tap:executing",
  "target": "https://taprun.dev/taps/creem/validate-license",
  "body": {
    "type": "tap:ExecutionPlan",
    "site": "creem",
    "name": "validate-license",
    "intent": "write",
    "description": "Validate a Creem license key and check activation status",
    "columns": [
      "key",
      "status",
      "product",
      "activation",
      "limit",
      "expires",
      "instance"
    ],
    "args": {
      "key": {
        "type": "string",
        "required": true,
        "description": "Creem API key"
      },
      "license": {
        "type": "string",
        "required": true,
        "description": "License key to validate"
      },
      "instance": {
        "type": "string",
        "required": true,
        "description": "Instance ID (from activate)"
      }
    },
    "health": {
      "min_rows": 1,
      "non_empty": []
    }
  },
  "seeAlso": [
    "https://github.com/LeonTing1010/tap-skills/blob/main/community/creem/validate-license.tap.json",
    "https://taprun.dev/taps/creem/validate-license.html"
  ]
}
