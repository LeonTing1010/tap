{
  "@context": [
    "http://www.w3.org/ns/anno.jsonld",
    "https://taprun.dev/ns/tap-v1"
  ],
  "@type": "Annotation",
  "id": "https://taprun.dev/taps/creem/subscriptions",
  "motivation": "tap:executing",
  "target": "https://taprun.dev/taps/creem/subscriptions",
  "body": {
    "type": "tap:ExecutionPlan",
    "site": "creem",
    "name": "subscriptions",
    "intent": "read",
    "description": "List all Creem subscriptions with customer, product, and status",
    "columns": [
      "email",
      "product",
      "status",
      "price",
      "period_end",
      "id"
    ],
    "args": {
      "key": {
        "type": "string",
        "required": true,
        "description": "Creem API key"
      }
    },
    "health": {
      "min_rows": 1,
      "requires_auth": true
    }
  },
  "seeAlso": [
    "https://github.com/LeonTing1010/tap-skills/blob/main/community/creem/subscriptions.tap.js",
    "https://taprun.dev/taps/creem/subscriptions.html"
  ]
}
