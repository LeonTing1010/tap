{
  "@context": [
    "http://www.w3.org/ns/anno.jsonld",
    "https://taprun.dev/ns/tap-v1"
  ],
  "@type": "Annotation",
  "id": "https://taprun.dev/taps/scys/article",
  "motivation": "tap:executing",
  "target": "https://taprun.dev/taps/scys/article",
  "body": {
    "type": "tap:ExecutionPlan",
    "site": "scys",
    "name": "article",
    "intent": "read",
    "description": "Read SCYS article with title, author, stats, full text",
    "columns": [
      "type",
      "content",
      "meta"
    ],
    "args": {
      "url": {
        "type": "string",
        "description": "Article URL (optional, reads current page if omitted)"
      }
    },
    "health": {
      "min_rows": 3,
      "non_empty": [
        "content"
      ]
    }
  },
  "seeAlso": [
    "https://github.com/LeonTing1010/tap-skills/blob/main/community/scys/article.tap.json",
    "https://taprun.dev/taps/scys/article.html"
  ]
}
