{
  "@context": [
    "http://www.w3.org/ns/anno.jsonld",
    "https://taprun.dev/ns/tap-v1"
  ],
  "@type": "Annotation",
  "id": "https://taprun.dev/taps/hackernews/hot",
  "motivation": "tap:executing",
  "target": "https://taprun.dev/taps/hackernews/hot",
  "body": {
    "type": "tap:ExecutionPlan",
    "site": "hackernews",
    "name": "hot",
    "intent": "read",
    "description": "Hacker News hot stories - Top stories from Hacker News front page, including rank, title, points, comment count, age, author, ID, and URL. The go-to information source for tech entrepreneurs and developers.",
    "columns": ["rank", "title", "points", "comments", "age", "author", "id", "url"],
    "args": {
      "limit": {
        "type": "int",
        "default": 30,
        "description": "Number of stories to return"
      }
    },
    "health": {
      "min_rows": 10,
      "non_empty": ["title", "points"]
    }
  },
  "seeAlso": [
    "https://github.com/LeonTing1010/tap-skills/blob/main/showcase/hackernews/hot.tap.js",
    "https://taprun.dev/taps/hackernews/hot.html"
  ]
}
