{
  "@context": [
    "http://www.w3.org/ns/anno.jsonld",
    {
      "@version": 1.1,
      "tap": "https://taprun.dev/ns/tap-v1#",
      "oa": "http://www.w3.org/ns/oa#",
      "owl": "http://www.w3.org/2002/07/owl#",
      "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
      "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "schema": "http://schema.org/",
      "dcterms": "http://purl.org/dc/terms/",
      "prov": "http://www.w3.org/ns/prov#"
    }
  ],

  "@id": "https://taprun.dev/ns/tap-v1",
  "@type": "owl:Ontology",
  "dcterms:title": "Tap v1 Web Annotation Extension Vocabulary",
  "dcterms:description": "Tap-namespaced extensions to the W3C Web Annotation Data Model. Two surfaces ship terms on disk: a compiled Tap program stored as a `.tap.json` W3C Annotation (motivation `tap:executing`, body `tap:ExecutionPlan`), and a doctor assessment Annotation (motivation `oa:assessing`, body carrying `tap:verdict` and related diagnostic properties). Additional terms (`tap:SemanticHashState`, `tap:JsonPathSelector`, and their sub-properties) are defined for forge-time intermediate fingerprint artifacts and are not persisted in a stored `.tap.json`. The Tap runtime parses `tap:*` fields by literal key and does not require a remote-context fetch; this document exists as a stable identifier and as documentation for external tooling.",
  "dcterms:issued": "2026-04-15",
  "dcterms:modified": "2026-04-23",
  "dcterms:creator": {
    "@type": "schema:Organization",
    "schema:name": "TapRun",
    "schema:url": "https://taprun.dev/"
  },
  "dcterms:license": "https://creativecommons.org/publicdomain/zero/1.0/",
  "dcterms:isVersionOf": "https://taprun.dev/ns/tap-v1",
  "owl:versionInfo": "tap-v1",
  "rdfs:seeAlso": [
    "https://www.w3.org/TR/annotation-model/",
    "https://www.w3.org/TR/annotation-vocab/",
    "https://www.w3.org/TR/selectors-states/",
    "https://www.rfc-editor.org/rfc/rfc9535",
    "https://taprun.dev/"
  ],

  "@graph": [
    {
      "@id": "tap:executing",
      "@type": "oa:Motivation",
      "rdfs:label": "executing",
      "rdfs:comment": "Program-level execution. Declares that the annotation carries a deterministic `tap:ExecutionPlan` that replays the documented interaction against the target resource. The canonical motivation for a stored Tap program (`.tap.json`). A consumer that cannot execute the plan still sees a valid W3C Annotation with a target IRI and a structured body.",
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    },

    {
      "@id": "tap:ExecutionPlan",
      "@type": "rdfs:Class",
      "rdfs:label": "Execution Plan",
      "rdfs:comment": "Body type of a compiled Tap program. Carries `site`, `name`, `intent`, `description`, `health`, `args`, `columns`, and an ordered `ops` array of operations drawn from a closed 25-member union (the Tap op set). Serialized as bare JSON keys under the body object — JSON-LD consumers that follow the `tap:` vocabulary treat them as the `tap:*` properties defined below. Pure data: `ops[*].fn` is a source-level function string, never evaluated at parse time. See the Tap operation schema for the op union.",
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    },

    {
      "@id": "tap:site",
      "@type": "rdf:Property",
      "rdfs:label": "site",
      "rdfs:comment": "Site identifier — the logical namespace a tap belongs to (e.g. `github`, `reddit`). Part of the `{site}/{name}` coordinate used everywhere in Tap. Appears as a bare `site` key inside a `tap:ExecutionPlan` body.",
      "rdfs:domain": { "@id": "tap:ExecutionPlan" },
      "rdfs:range": { "@id": "xsd:string" },
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    },

    {
      "@id": "tap:name",
      "@type": "rdf:Property",
      "rdfs:label": "name",
      "rdfs:comment": "Tap identifier within a site namespace (e.g. `trending`, `publish`). Together with tap:site forms the unique `{site}/{name}` coordinate. Appears as a bare `name` key inside a `tap:ExecutionPlan` body.",
      "rdfs:domain": { "@id": "tap:ExecutionPlan" },
      "rdfs:range": { "@id": "xsd:string" },
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    },

    {
      "@id": "tap:intent",
      "@type": "rdf:Property",
      "rdfs:label": "intent",
      "rdfs:comment": "Tap direction — `read` (idempotent data retrieval; doctor runs automatically) or `write` (side-effecting action; doctor skips unless opted in). Drives whether verification may safely re-execute the tap. Appears as a bare `intent` key inside a `tap:ExecutionPlan` body.",
      "rdfs:domain": { "@id": "tap:ExecutionPlan" },
      "rdfs:range": { "@id": "xsd:string" },
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    },

    {
      "@id": "tap:health",
      "@type": "rdf:Property",
      "rdfs:label": "health",
      "rdfs:comment": "Health contract for a read tap — declarative gates (`min_rows`, `non_empty` fields, etc.) that doctor evaluates to decide HEALTHY vs BROKEN. Opaque JSON object. Appears as a bare `health` key inside a `tap:ExecutionPlan` body.",
      "rdfs:domain": { "@id": "tap:ExecutionPlan" },
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    },

    {
      "@id": "tap:args",
      "@type": "rdf:Property",
      "rdfs:label": "args",
      "rdfs:comment": "Argument schema for a tap — parameter name → { type, default, description }. Opaque JSON object; drives `tap.run` input validation and MCP tool schemas. Appears as a bare `args` key inside a `tap:ExecutionPlan` body.",
      "rdfs:domain": { "@id": "tap:ExecutionPlan" },
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    },

    {
      "@id": "tap:verdict",
      "@type": "rdf:Property",
      "rdfs:label": "verdict",
      "rdfs:comment": "Doctor verdict on an assessing annotation — one of `healthy`, `broken`, `stale`, `layer-mismatch`, `unreachable`. `unreachable` signals that the target resource could not be fetched (DNS failure, timeout, network error) and is distinct from `broken`, which signals that the tap ran against a fetched page but produced output that violates its health contract.",
      "rdfs:range": { "@id": "xsd:string" },
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    },

    {
      "@id": "tap:compiledFromLayer",
      "@type": "rdf:Property",
      "rdfs:label": "compiledFromLayer",
      "rdfs:comment": "Trust layer (1-4) the tap was compiled from. 1 = explicit declarations (JSON-LD, Open Graph, agents.json). 2 = data contracts (API, SSR globals). 3 = semantic structure (ARIA, headings). 4 = implementation details (CSS classes). Derived from the tap's target address via `selectorLayer()`. Emitted in the body of an `oa:assessing` doctor annotation.",
      "rdfs:range": { "@id": "xsd:integer" },
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    },

    {
      "@id": "tap:recommendedLayer",
      "@type": "rdf:Property",
      "rdfs:label": "recommendedLayer",
      "rdfs:comment": "Layer doctor recommends re-forging from, when a higher-trust layer is available than the one the tap currently uses. Nullable. Emitted in the body of an `oa:assessing` doctor annotation.",
      "rdfs:range": { "@id": "xsd:integer" },
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    },

    {
      "@id": "tap:crossValidation",
      "@type": "rdf:Property",
      "rdfs:label": "crossValidation",
      "rdfs:comment": "Layer-cross-validation record — `{ layer1Value, observedValue, disagreement }`. Populated when Layer-1 (JSON-LD) says one thing and the tap's extraction returns another. Fires the `layer-mismatch` verdict. Emitted in the body of an `oa:assessing` doctor annotation.",
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    },

    {
      "@id": "tap:suggestions",
      "@type": "rdf:Property",
      "rdfs:label": "suggestions",
      "rdfs:comment": "Ordered list of actionable diagnostic suggestions attached to an assessing annotation — each suggestion names a specific fix (refresh fingerprint, re-forge from Layer N, check auth, etc.). Emitted in the body of an `oa:assessing` doctor annotation.",
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    },

    {
      "@id": "tap:JsonPathSelector",
      "@type": "rdfs:Class",
      "rdfs:subClassOf": { "@id": "oa:Selector" },
      "rdfs:label": "JSONPath Selector",
      "rdfs:comment": "Selects a JSON value using a JSONPath expression per RFC 9535. Used by forge during structural candidate selection against Layer 1/2 JSON sources — JSON-LD blocks, embedded state globals (e.g. `__NEXT_DATA__`), and structured API responses. Scope: forge-time intermediate only; not persisted in a stored `.tap.json`. Not part of W3C Selectors and States (2017) because JSONPath was not ratified until RFC 9535 in 2024.",
      "dcterms:conformsTo": { "@id": "https://www.rfc-editor.org/rfc/rfc9535" },
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    },

    {
      "@id": "tap:SemanticHashState",
      "@type": "rdfs:Class",
      "rdfs:subClassOf": { "@id": "oa:State" },
      "rdfs:label": "Semantic Hash State",
      "rdfs:comment": "Fingerprint blob capturing the structural hash of a target resource at authoring time. Properties: `tap:rootHash`, `tap:selectors`, `tap:endpoints`, `tap:jsonLdValues`. Scope: forge-time intermediate only — the fingerprint is tracked inside Tap but is not serialized into a stored `.tap.json` Annotation body. Doctor's drift detection walks the live fingerprint, not a stored copy.",
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    },

    {
      "@id": "tap:rootHash",
      "@type": "rdf:Property",
      "rdfs:label": "rootHash",
      "rdfs:comment": "FNV-1a Merkle root hash over all captured sub-hashes (selectors, endpoints, globals, JSON-LD types, page, write actions). Enables O(1) drift detection: if the root changes the tap may be STALE or BROKEN. Scope: forge-time fingerprint property, not persisted in a stored `.tap.json`.",
      "rdfs:domain": { "@id": "tap:SemanticHashState" },
      "rdfs:range": { "@id": "xsd:string" },
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    },

    {
      "@id": "tap:selectors",
      "@type": "rdf:Property",
      "rdfs:label": "selectors",
      "rdfs:comment": "Captured selector population summary — count and ARIA/semantic hash. Opaque JSON object; Tap is the authoritative consumer. Scope: forge-time fingerprint property, not persisted in a stored `.tap.json`.",
      "rdfs:domain": { "@id": "tap:SemanticHashState" },
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    },

    {
      "@id": "tap:endpoints",
      "@type": "rdf:Property",
      "rdfs:label": "endpoints",
      "rdfs:comment": "Captured network endpoints observed during forge, each with URL and JSON response shape hash (keys + types). Array of objects; Tap is the authoritative consumer. Scope: forge-time fingerprint property, not persisted in a stored `.tap.json`.",
      "rdfs:domain": { "@id": "tap:SemanticHashState" },
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    },

    {
      "@id": "tap:jsonLdValues",
      "@type": "rdf:Property",
      "rdfs:label": "jsonLdValues",
      "rdfs:comment": "Deduplicated list of Schema.org `@type` names observed in Layer-1 (JSON-LD) blocks at authoring time. Used by doctor as a cheap drift signal — if the set of declared `@type` tokens changes between forge and run, the page's structural contract has shifted. Cross-layer value validation (DOM-vs-JSON-LD disagreement → `layer-mismatch` verdict) uses the live fingerprint diff at doctor time rather than a stored field→value snapshot. Represented as `string[]`. Scope: forge-time fingerprint property, not persisted in a stored `.tap.json`.",
      "rdfs:domain": { "@id": "tap:SemanticHashState" },
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    },

    {
      "@id": "tap:extracting",
      "@type": "oa:Motivation",
      "owl:deprecated": true,
      "rdfs:label": "extracting",
      "rdfs:comment": "DEPRECATED as of tap-v1 (2026-04-23). Superseded by `tap:executing`. Historically declared as the motivation for a data-extraction annotation, but shipped only in forge-time intermediate candidate selectors — never reached a stored `.tap.json`. Retained for namespace stability; consumers should treat any occurrence as equivalent to `tap:executing`.",
      "owl:equivalentProperty": { "@id": "tap:executing" },
      "rdfs:isDefinedBy": { "@id": "https://taprun.dev/ns/tap-v1" }
    }
  ]
}
