{
  "name": "@taprun/from-stagehand",
  "version": "0.1.2",
  "description": "Migrate Stagehand (Browserbase) AI flows to MCP-compatible plans. Deterministic Playwright calls compile to plan ops; stagehand.act/extract/observe preserve their natural-language prompts. Run agent flows at zero LLM tokens in Claude Code, Cursor, and any MCP host.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/conversion.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "stagehand",
    "stagehand-mcp",
    "stagehand-alternative",
    "browserbase",
    "browserbase-alternative",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "ai-agent",
    "browser-agent",
    "browser-automation",
    "playwright",
    "deterministic",
    "compile",
    "replay",
    "natural-language-automation",
    "drift-detection",
    "tap",
    "taprun",
    "plan-v1"
  ],
  "homepage": "https://taprun.dev/spec/plan-v1/?utm_source=npm&utm_medium=package&utm_campaign=from-stagehand",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonTing1010/tap.git",
    "directory": "packages/from-stagehand"
  },
  "bugs": {
    "url": "https://github.com/LeonTing1010/tap/issues"
  },
  "license": "MIT",
  "author": "Leon Ting <noreply@taprun.dev>",
  "peerDependencies": {
    "@taprun/spec": "^0.4.0"
  },
  "devDependencies": {
    "@taprun/spec": "^0.4.0",
    "typescript": "^5.5.0"
  }
}
