{
  "name": "@taprun/from-puppeteer",
  "version": "1.0.1",
  "description": "Convert Puppeteer scripts to Tap Plan v2 — deterministic browser-automation plans for Claude Code, Cursor, and any MCP host. Zero LLM tokens at replay.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/conversion.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "puppeteer",
    "puppeteer-migration",
    "puppeteer-converter",
    "puppeteer-to-mcp",
    "headless-chrome",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "ai-agent",
    "browser-automation",
    "browser-agent",
    "deterministic",
    "compile",
    "replay",
    "scraping",
    "drift-detection",
    "tap",
    "taprun",
    "plan-v2"
  ],
  "homepage": "https://taprun.dev/spec/plan-v2/?utm_source=npm&utm_medium=package&utm_campaign=from-puppeteer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonTing1010/tap.git",
    "directory": "packages/from-puppeteer"
  },
  "bugs": {
    "url": "https://github.com/LeonTing1010/tap/issues"
  },
  "license": "MIT",
  "author": "Leon Ting <noreply@taprun.dev>",
  "peerDependencies": {
    "@taprun/spec": "^1.0.0"
  },
  "devDependencies": {
    "@taprun/spec": "^1.0.0",
    "typescript": "^5.5.0"
  }
}
