{
  "id": {
    "site": "example",
    "name": "login"
  },
  "act": [
    { "op": "nav", "url": "https://example.test/login" },
    { "op": "input", "kind": "type", "target": "#username", "value": "alice" },
    { "op": "input", "kind": "type", "target": "#password", "value": "secret" },
    { "op": "input", "kind": "press", "value": "Enter" },
    { "op": "wait", "selector": ".dashboard" }
  ],
  "key": "\"example:login:\" + string($args)",
  "return": "true"
}
