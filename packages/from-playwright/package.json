{
  "name": "@taprun/from-playwright",
  "version": "0.1.1",
  "description": "Convert Playwright test scripts (.ts / .js source) into Tap plan-v1 .tap.json files. Reference adapter for the @taprun/spec format.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test 'test/**/*.test.mjs'",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "tap",
    "taprun",
    "playwright",
    "adapter",
    "browser-automation",
    "scraping",
    "drift-detection",
    "plan-v1"
  ],
  "homepage": "https://taprun.dev/spec/plan-v1/?utm_source=npm&utm_medium=package&utm_campaign=from-playwright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonTing1010/tap.git",
    "directory": "packages/from-playwright"
  },
  "bugs": {
    "url": "https://github.com/LeonTing1010/tap/issues"
  },
  "license": "MIT",
  "author": "Leon Ting <noreply@taprun.dev>",
  "peerDependencies": {
    "@taprun/spec": "^0.3.0"
  },
  "devDependencies": {
    "@taprun/spec": "^0.3.0",
    "typescript": "^5.5.0"
  }
}
