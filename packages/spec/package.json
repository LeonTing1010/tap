{
  "name": "@taprun/spec",
  "version": "1.9.0",
  "description": "Tap v2 plan format \u2014 public TypeScript types for the 13-op closed union, Plan discriminated union, and state-machine enums (Verdict, IntentState). Schema break vs v0.x; see ADR 2026-05-04-ecosystem-v2-launch.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": "./schemas/plan-v1.schema.json"
  },
  "files": [
    "dist/types.js",
    "dist/types.d.ts",
    "dist/lint.js",
    "dist/lint.d.ts",
    "dist/ns-vocabulary.js",
    "dist/ns-vocabulary.d.ts",
    "dist/index.js",
    "dist/index.d.ts",
    "schemas/plan-v1.schema.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && node scripts/pre-publish-check.ts",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "tap",
    "taprun",
    "plan-v2",
    "spec",
    "types",
    "mcp",
    "model-context-protocol",
    "browser-automation",
    "ai-agent"
  ],
  "homepage": "https://taprun.dev/spec/plan-v2/?utm_source=npm&utm_medium=package&utm_campaign=spec",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonTing1010/tap.git",
    "directory": "packages/spec"
  },
  "bugs": {
    "url": "https://github.com/LeonTing1010/tap/issues"
  },
  "license": "MIT",
  "author": "Leon Ting <noreply@taprun.dev>",
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
