{
  "name": "@taprun/spec",
  "version": "0.4.3",
  "description": "Browser automation plan format for MCP servers and AI agents — TypeScript types + W3C Annotation validator + JSON Schema for .tap.json. Used by Tap and its Playwright / Puppeteer / Stagehand converters. Typecheck or validate plans without the full Tap CLI.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": "./schemas/plan-v1.schema.json",
    "./schemas/plan-v1.schema.json": "./schemas/plan-v1.schema.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "spec",
    "json-schema",
    "w3c-annotation",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "ai-agent",
    "browser-automation",
    "browser-agent",
    "playwright",
    "puppeteer",
    "stagehand",
    "deterministic",
    "compile",
    "replay",
    "scraping",
    "drift-detection",
    "tap",
    "taprun",
    "plan-v1"
  ],
  "homepage": "https://taprun.dev/spec/plan-v1/?utm_source=npm&utm_medium=package&utm_campaign=spec",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonTing1010/tap.git",
    "directory": "packages/spec"
  },
  "bugs": {
    "url": "https://github.com/LeonTing1010/tap/issues"
  },
  "license": "MIT",
  "author": "Leon Ting <noreply@taprun.dev>",
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
