{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taprun.dev/spec/plan-v1/schema.json",
  "title": "Tap Flow v1",
  "description": "On-disk format for Tap v2 flows (bare JSON; no W3C Annotation envelope). Flows are a discriminated union of read (observe+return) and write (act+key+confirm?) variants.",
  "$comment": "GENERATED from core/types.ts by scripts/gen-plan-schema.ts — DO NOT EDIT BY HAND. Regenerate: deno task gen:plan-schema. Freshness: gen:plan-schema --check (blocking).",
  "oneOf": [
    {
      "$ref": "#/$defs/FlowRead"
    },
    {
      "$ref": "#/$defs/FlowWrite"
    }
  ],
  "$defs": {
    "Shape": {
      "description": "Witnessed value shape (ADR 2026-08-01-shape-algebra-witnessed-semilattice): a bounded join-semilattice recording what a value looked like. Emitted by freeze from the live session's actual values (the must_candidate lane); never authored by hand, never required. Bounds enforced by the emitter (depth<=4, width<=32, lits<=8); this schema pins the wire form.",
      "type": "object",
      "required": [
        "t"
      ],
      "oneOf": [
        {
          "properties": {
            "t": {
              "enum": [
                "bot",
                "dyn",
                "null"
              ]
            }
          },
          "required": [
            "t"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "t": {
              "const": "bool"
            },
            "n": {
              "const": true
            }
          },
          "required": [
            "t"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "t": {
              "const": "str"
            },
            "lits": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 8
            },
            "n": {
              "const": true
            }
          },
          "required": [
            "t"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "t": {
              "const": "num"
            },
            "lits": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "maxItems": 8
            },
            "n": {
              "const": true
            }
          },
          "required": [
            "t"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "t": {
              "const": "arr"
            },
            "e": {
              "$ref": "#/$defs/Shape"
            },
            "n": {
              "const": true
            }
          },
          "required": [
            "t",
            "e"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "t": {
              "const": "obj"
            },
            "f": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "required": [
                  "k",
                  "s"
                ],
                "additionalProperties": false,
                "properties": {
                  "k": {
                    "type": "string"
                  },
                  "s": {
                    "$ref": "#/$defs/Shape"
                  },
                  "opt": {
                    "const": true
                  }
                }
              }
            },
            "n": {
              "const": true
            }
          },
          "required": [
            "t",
            "f"
          ],
          "additionalProperties": false
        }
      ]
    },
    "TapId": {
      "type": "object",
      "description": "Pure identity for a tap. Two TapIds equal iff site AND name match.",
      "required": [
        "site",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "site": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CelExpr": {
      "type": "string",
      "description": "A CEL expression source string. Validated by the engine's CEL Environment at lint time."
    },
    "ArgSpec": {
      "type": "object",
      "description": "Argument schema declaration on a Flow.",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "string",
            "int",
            "number",
            "boolean",
            "object",
            "array"
          ]
        },
        "default": {},
        "required": {
          "const": true
        },
        "description": {
          "type": "string"
        }
      }
    },
    "OpName": {
      "type": "string",
      "description": "Closed 18-op union. Mirrors OP_NAMES_V2 in core/types.ts (generated).",
      "enum": [
        "fetch",
        "nav",
        "wait",
        "input",
        "extract",
        "cookies",
        "tap",
        "if",
        "foreach",
        "parallel",
        "eval",
        "tab",
        "bookmark",
        "pdf",
        "notify",
        "ax",
        "host",
        "screenshot"
      ]
    },
    "NavAttachMatchMode": {
      "type": "string",
      "description": "Per ADR tap-core/docs/adr/2026-05-14-op-nav-attach.md. Closed 3-arm.",
      "enum": [
        "url-prefix",
        "origin",
        "exact"
      ]
    },
    "NavAttach": {
      "description": "Tab-attach directive on op:nav. `true` shorthand = { match: 'url-prefix' }. `reload:false` = bind-only on match (no page reload).",
      "oneOf": [
        {
          "const": true
        },
        {
          "type": "object",
          "required": [
            "match"
          ],
          "additionalProperties": false,
          "properties": {
            "match": {
              "$ref": "#/$defs/NavAttachMatchMode"
            },
            "reload": {
              "type": "boolean",
              "description": "false = when a tab MATCHED, bind without navigating (no tabs.update/reload) — preserves live page state (form drafts) in the user's tab. 0 matches still falls through to create+navigate. Absent/true = navigate-always (today's behavior)."
            }
          }
        }
      ]
    },
    "TargetResolver": {
      "type": "object",
      "anyOf": [
        {
          "required": [
            "selector"
          ]
        },
        {
          "required": [
            "role"
          ]
        }
      ],
      "additionalProperties": false,
      "description": "Explicit predicate over a match set (ADR 2026-07-08-target-resolver + -ax). Selection: candidates (deepQueryAll(selector), or the common-role set when role-only) → filter role → filter name → filter visible → filter text → filter inViewport → index nth. Re-resolved at act-time by the peer. A bare string target is sugar for { selector, visible: true }. Requires selector OR role.",
      "properties": {
        "selector": {
          "type": "string",
          "description": "CSS selector. The ' >>> ' piercing combinator crosses BOTH shadow-root AND iframe boundaries: 'iframeSel >>> innerSel' targets an element inside an iframe (same- or cross-origin). A bare selector searches only the top document and will NOT match inside an iframe. Optional when role is given."
        },
        "role": {
          "type": "string",
          "description": "ARIA role (explicit role= or implicit from tag). Selector-free semantic targeting; survives React class/DOM churn that breaks CSS selectors."
        },
        "name": {
          "type": "string",
          "description": "Accessible-name substring (aria-label → aria-labelledby → <label> → alt/title → textContent), trimmed + case-insensitive."
        },
        "visible": {
          "type": "boolean",
          "description": "Keep only rendered matches (offsetParent set / non-zero box / not display:none·hidden·opacity:0). Kills the 'first match is a hidden template' footgun."
        },
        "nth": {
          "type": "number",
          "description": "0-based index into the filtered set; negative counts from the end (-1 = last = newest in append-ordered chat/list UIs). Default 0. Out-of-range → element_not_found."
        },
        "text": {
          "type": "string",
          "description": "Keep only matches whose textContent includes this substring (trimmed, case-sensitive)."
        },
        "inViewport": {
          "type": "boolean",
          "description": "Keep only matches intersecting the viewport — precondition for a trusted CDP click."
        },
        "topmost": {
          "type": "boolean",
          "description": "Keep only matches that actually RECEIVE a pointer event at their center (elementFromPoint hit-test: the hit is the match, inside it, or its ancestor). Kills the stacked-dialog trap — SPAs that keep every dialog mounted (weui admin consoles) leave N same-class buttons 'visible'; only the top of the stack is interactable. Off-viewport candidates pass (nothing to hit-test); combine with the click op's own scroll-into-view."
        },
        "within": {
          "$ref": "#/$defs/Target",
          "description": "Scope: resolve THIS resolver inside the subtree of the element `within` resolves to (recursively nestable). The relational query — 'the button INSIDE the card whose text includes X' — in ONE op, replacing the eval-marker two-op TOCTOU. Per ADR 2026-07-12-target-resolver-within."
        }
      }
    },
    "Target": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/TargetResolver"
        }
      ]
    },
    "FetchOp": {
      "type": "object",
      "required": [
        "op",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        },
        "op": {
          "const": "fetch"
        },
        "url": {
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "DELETE",
            "PATCH"
          ]
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {},
        "format": {
          "enum": [
            "json",
            "text",
            "arrayBuffer"
          ]
        },
        "credentials": {
          "enum": [
            "deno-host",
            "page-session"
          ],
          "description": "Same-origin only when 'page-session' — the user's logged-in browser cookies authenticate."
        },
        "save": {
          "type": "string"
        },
        "expect": {
          "$ref": "#/$defs/CelExpr",
          "description": "Per-op postcondition (ADR 2026-05-08 §2B): CEL over { …scope, $result } after a successful fetch. Falsy → tap_drifted."
        }
      }
    },
    "NavOp": {
      "type": "object",
      "required": [
        "op",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        },
        "op": {
          "const": "nav"
        },
        "url": {
          "type": "string"
        },
        "attach": {
          "$ref": "#/$defs/NavAttach"
        },
        "save": {
          "type": "string"
        }
      }
    },
    "WaitOp": {
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        },
        "op": {
          "const": "wait"
        },
        "ms": {
          "type": "number"
        },
        "selector": {
          "$ref": "#/$defs/Target"
        },
        "url": {
          "type": "string",
          "description": "Wait until location.href includes this substring — deterministic SPA route-change wait (ADR 2026-07-08-op-capabilities). Tab-bound; polled in-page."
        },
        "target": {
          "type": "object",
          "description": "Desktop wait target — macos-bridge peer only (ADR 2026-07-28). Resolves via AXUIElement (`ax`) or vision fallback (`vision`)."
        },
        "appBundleId": {
          "type": "string"
        },
        "timeout_ms": {
          "type": "number"
        },
        "stable": {
          "type": "boolean",
          "description": "Quiesce the LIVE page (DOM + network idle) instead of waiting on a condition. Tab-bound by construction (types.ts:waitNeedsTab) — engineWait cannot honour it."
        },
        "save": {
          "type": "string"
        }
      }
    },
    "InputOp": {
      "type": "object",
      "required": [
        "op",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        },
        "op": {
          "const": "input"
        },
        "kind": {
          "enum": [
            "click",
            "type",
            "fill",
            "press",
            "upload",
            "setHtml",
            "hover",
            "keytype",
            "blur",
            "scroll"
          ]
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "value": {
          "type": "string"
        },
        "trusted": {
          "type": "boolean",
          "description": "Substrate-tier hint. Absent/false (default) → L1: JS-injection el.click() — isTrusted:false, CSP-immune, no DevTools bar. true → L2: CDP-dispatched mouse events at element coordinates (isTrusted:true). L2 is REQUIRED to activate gesture-bound framework buttons (Polymer/Wiz tap recognizers — e.g. YouTube Studio ytcp-button, Material ripple buttons) that ignore a synthetic JS click. Set by capture when forge detects L1 fails the expect predicate; authors may set it directly when a click silently no-ops on a framework button."
        },
        "appBundleId": {
          "type": "string",
          "description": "Target a specific app for the synthesized input (ADR 2026-07-28). When set, a `click` resolves its target element inside this app's AX tree and posts the CGEvent to that app's PID."
        },
        "expect": {
          "$ref": "#/$defs/CelExpr",
          "description": "Per-op postcondition (ADR 2026-05-08 §2B): CEL over { …scope, $result }. Falsy → tap_drifted."
        },
        "save": {
          "type": "string"
        }
      }
    },
    "ExtractSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attr": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "innerText": {
          "type": "string"
        },
        "html": {
          "type": "string"
        },
        "exists": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        }
      }
    },
    "ExtractOp": {
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        },
        "op": {
          "const": "extract"
        },
        "root": {
          "type": "string",
          "description": "ROOT selector (live/HTML sources) or a JSON path into the captured entries array (network source, e.g. \"entries[*]\"). Required for a read; optional for the network source arm/stop modes."
        },
        "per_item": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ExtractSpec"
          }
        },
        "from": {
          "type": "string",
          "description": "JSONata expression resolving to the source HTML string, OR the sentinel \"network\" selecting the CDP-captured-response source (ADR 2026-07-23). Omitted defaults to _phase_last (prior op:fetch HTML). HTML parses engine-inline (deno-dom, tab-free); \"network\" routes to the peer."
        },
        "live": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "arm",
            "read",
            "stop"
          ],
          "description": "Capture lifecycle for from:\"network\" (ADR 2026-07-23). \"arm\" starts CDP capture (no read); \"read\" (default) dumps + applies per_item over the buffered entries; \"stop\" ends capture. Ignored for HTML/live sources."
        },
        "save": {
          "type": "string"
        }
      }
    },
    "CookiesOp": {
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        },
        "op": {
          "const": "cookies"
        },
        "domain": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "save": {
          "type": "string"
        }
      }
    },
    "TapOp": {
      "type": "object",
      "required": [
        "op",
        "site",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        },
        "op": {
          "const": "tap"
        },
        "site": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "args": {
          "type": "object"
        },
        "save": {
          "type": "string"
        }
      }
    },
    "IfOp": {
      "type": "object",
      "required": [
        "op",
        "cond",
        "then"
      ],
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        },
        "op": {
          "const": "if"
        },
        "cond": {
          "$ref": "#/$defs/CelExpr"
        },
        "then": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Op"
          }
        },
        "else": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Op"
          }
        },
        "save": {
          "type": "string"
        }
      }
    },
    "ForeachOp": {
      "type": "object",
      "required": [
        "op",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        },
        "op": {
          "const": "foreach"
        },
        "over": {
          "$ref": "#/$defs/CelExpr"
        },
        "count": {
          "type": "number"
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Op"
          }
        },
        "until": {
          "$ref": "#/$defs/CelExpr"
        },
        "save": {
          "type": "string"
        }
      }
    },
    "ParallelOp": {
      "type": "object",
      "required": [
        "op",
        "branches"
      ],
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        },
        "op": {
          "const": "parallel"
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Op"
            }
          }
        },
        "save": {
          "type": "string"
        }
      }
    },
    "EvalOp": {
      "type": "object",
      "description": "Page-context JS escape hatch. `returns.type` is OPTIONAL — when present the runtime schema-validates output before binding; when omitted the value is bound as-is.",
      "required": [
        "op",
        "fn"
      ],
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        },
        "op": {
          "const": "eval"
        },
        "fn": {
          "type": "string"
        },
        "returns": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "string",
                "number",
                "boolean",
                "object",
                "array"
              ]
            },
            "shape": {
              "$ref": "#/$defs/Shape"
            }
          }
        },
        "args": {
          "type": "array"
        },
        "save": {
          "type": "string"
        },
        "mutates": {
          "type": "boolean",
          "description": "Does this eval body DISPATCH a side effect (HTTP write, beacon)? The act-phase mutation tracker keys the honest-failure edge, the commit-gate and lint `must-missing` on this fact. Omit and the tracker DETECTS dispatch syntax in `fn` — declaring it is exact. `false` overrides a false-positive detection (inert string, read-only GET). See notes/engine-gaps/eval-invisible-mutation-2026-08-01.md."
        }
      }
    },
    "TabGroupColor": {
      "type": "string",
      "description": "Closed tab-group color set — mirrors chrome.tabGroups.Color.",
      "enum": [
        "grey",
        "blue",
        "red",
        "yellow",
        "green",
        "pink",
        "purple",
        "cyan",
        "orange"
      ]
    },
    "TabOp": {
      "type": "object",
      "description": "Host op — browser-harness management (tabs / tab-groups). Acts on the user's own browser chrome, not a foreign substrate. Tab-free; peer-routed to the extension. Per ADR 2026-06-11-op-tab-host-op.md.",
      "required": [
        "op",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        },
        "op": {
          "const": "tab"
        },
        "action": {
          "enum": [
            "list",
            "group",
            "ungroup",
            "close",
            "pin",
            "unpin"
          ]
        },
        "tabIds": {
          "description": "Target tabs for group/ungroup/close/pin/unpin. A literal number[] or a template string resolving to number[]. Omit for action:list.",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "string"
                ]
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/TabGroupColor"
        },
        "save": {
          "type": "string"
        }
      }
    },
    "BookmarkOp": {
      "type": "object",
      "description": "Host op — bookmark-tree management. Same tier as TabOp: acts on the user's own browser chrome (chrome.bookmarks), not a foreign substrate. Tab-free; peer-routed to the extension. Per ADR 2026-06-11-op-bookmark-host-op.md.",
      "required": [
        "op",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        },
        "op": {
          "const": "bookmark"
        },
        "action": {
          "enum": [
            "tree",
            "create",
            "move",
            "update",
            "remove",
            "removeTree"
          ]
        },
        "id": {
          "type": "string",
          "description": "Target node id (move/update/remove/removeTree)."
        },
        "parentId": {
          "type": "string",
          "description": "Destination parent folder id (create/move)."
        },
        "index": {
          "type": "number",
          "description": "Position within the parent (create/move)."
        },
        "title": {
          "type": "string",
          "description": "Title (create folder/bookmark; update)."
        },
        "url": {
          "type": "string",
          "description": "URL (create/update a bookmark; omit for folder)."
        },
        "save": {
          "type": "string"
        }
      }
    },
    "PdfStamp": {
      "type": "object",
      "required": [
        "image",
        "page",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "description": "Stamp/annotation overlay for op:pdf mode:stamp (ADR 2026-07-15). Local signature image overlaid at declared coordinates. image is a local $file ref.",
      "properties": {
        "image": {
          "type": "string",
          "description": "$file ref to a local PNG/SVG signature image"
        },
        "page": {
          "type": "number",
          "description": "1-based page index"
        },
        "x": {
          "type": "number",
          "description": "PDF user-space points (72 dpi), origin bottom-left"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "description": "rendered width; height derived from image aspect"
        },
        "opacity": {
          "type": "number",
          "description": "0..1, default 1"
        },
        "imageBytes": {
          "type": "string",
          "description": "peer transport only — boundary-expanded base64; not authored"
        }
      }
    },
    "PdfOp": {
      "type": "object",
      "description": "Host op: PDF output. mode:export (default) = CDP Page.printToPDF of the bound tab (ADR 2026-07-08). mode:stamp = overlay stamp onto input PDF pdf (tab-free, deterministic — ADR 2026-07-15). pdfBytes is the peer-transport form of pdf, expanded from the $file ref at the dispatch boundary; not authored.",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        },
        "op": {
          "const": "pdf"
        },
        "mode": {
          "enum": [
            "export",
            "stamp"
          ]
        },
        "landscape": {
          "type": "boolean"
        },
        "printBackground": {
          "type": "boolean"
        },
        "paperWidth": {
          "type": "number"
        },
        "paperHeight": {
          "type": "number"
        },
        "pdf": {
          "type": "string",
          "description": "$file ref to the source PDF (stamp mode)"
        },
        "stamp": {
          "$ref": "#/$defs/PdfStamp"
        },
        "pdfBytes": {
          "type": "string",
          "description": "peer transport only — boundary-expanded base64; not authored"
        },
        "save": {
          "type": "string"
        }
      }
    },
    "NotifyOp": {
      "type": "object",
      "description": "Host op: push a message to the Tap side panel (plan->human output). Stored under chrome.storage.local['tap:notify'].",
      "required": [
        "op",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        },
        "op": {
          "const": "notify"
        },
        "message": {
          "type": "string"
        },
        "save": {
          "type": "string"
        }
      }
    },
    "AxOp": {
      "type": "object",
      "description": "Host-observation op (ADR 2026-07-12-op-ax-observation): CDP accessibility-tree survey of the bound tab. Returns {total, items:[{role,name,x,y,w,h,backendId}]} — role+name for every rendered node INCLUDING closed shadow roots page JS cannot reach. {role,name} is a ready-made input target; x/y feed a trusted:true coordinate click. No filter -> interactive roles only; role/name filter -> all roles.",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        },
        "op": {
          "const": "ax"
        },
        "role": {
          "type": "string",
          "description": "Exact AX role, case-insensitive (e.g. \"button\")."
        },
        "name": {
          "type": "string",
          "description": "Accessible-name substring, case-insensitive."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400,
          "description": "Max items returned. Default 120."
        },
        "appBundleId": {
          "type": "string",
          "description": "Target a specific app for introspection (ADR 2026-07-28). When set, the macos-bridge peer walks this app's AX tree regardless of focus."
        },
        "save": {
          "type": "string"
        }
      }
    },
    "ScreenshotOp": {
      "type": "object",
      "description": "Host output op (ADR 2026-07-19-op-screenshot): render the bound tab (or a clipped element) to an image via CDP Page.captureScreenshot. format png|jpeg, quality 0-100, target = CSS selector to clip. Produces a base64 image artifact persisted to ~/.tap/artifacts/<save>.<ext> (mirrors op:pdf).",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        },
        "op": {
          "const": "screenshot"
        },
        "format": {
          "enum": [
            "png",
            "jpeg"
          ]
        },
        "quality": {
          "type": "number"
        },
        "target": {
          "type": "string",
          "description": "CSS selector to clip (element screenshot); omit for full viewport"
        },
        "save": {
          "type": "string"
        }
      }
    },
    "HostCapSpec": {
      "type": "object",
      "required": [
        "namespace",
        "method"
      ],
      "additionalProperties": false,
      "description": "Resolved host-caps registry entry (Lane-B). Peer transport only — attached at the core dispatch boundary; not authored in flows.",
      "properties": {
        "namespace": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        }
      }
    },
    "HostOp": {
      "type": "object",
      "description": "Host op: invoke a thin host capability from the host-caps registry (Lane B, ADR 2026-07-16-primitive-set-narrow-waist-and-thin-host-capability-registry). `cap` names a registry entry mapped to a chrome.<namespace>.<method>(...) call; adding a capability is a registry entry (data), not new op code.",
      "required": [
        "op",
        "cap"
      ],
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        },
        "op": {
          "const": "host"
        },
        "cap": {
          "type": "string"
        },
        "args": {
          "type": "object"
        },
        "save": {
          "type": "string"
        },
        "_cap": {
          "$ref": "#/$defs/HostCapSpec",
          "description": "Peer transport only — the resolved registry spec, attached at the core dispatch boundary; NOT authored."
        }
      }
    },
    "Op": {
      "description": "The closed Op union — exactly 18 members. Discriminated by `op`. GENERATED from OP_NAMES_V2.",
      "oneOf": [
        {
          "$ref": "#/$defs/FetchOp"
        },
        {
          "$ref": "#/$defs/NavOp"
        },
        {
          "$ref": "#/$defs/WaitOp"
        },
        {
          "$ref": "#/$defs/InputOp"
        },
        {
          "$ref": "#/$defs/ExtractOp"
        },
        {
          "$ref": "#/$defs/CookiesOp"
        },
        {
          "$ref": "#/$defs/TapOp"
        },
        {
          "$ref": "#/$defs/IfOp"
        },
        {
          "$ref": "#/$defs/ForeachOp"
        },
        {
          "$ref": "#/$defs/ParallelOp"
        },
        {
          "$ref": "#/$defs/EvalOp"
        },
        {
          "$ref": "#/$defs/TabOp"
        },
        {
          "$ref": "#/$defs/BookmarkOp"
        },
        {
          "$ref": "#/$defs/PdfOp"
        },
        {
          "$ref": "#/$defs/NotifyOp"
        },
        {
          "$ref": "#/$defs/AxOp"
        },
        {
          "$ref": "#/$defs/HostOp"
        },
        {
          "$ref": "#/$defs/ScreenshotOp"
        }
      ]
    },
    "FlowLifecycle": {
      "type": "string",
      "description": "Tab lifetime policy. Absent ⇒ resolveLifecycle returns 'scoped' (RAII default).",
      "enum": [
        "scoped",
        "interactive"
      ]
    },
    "FlowIntent": {
      "type": "object",
      "description": "The durable verifiable intent (goal + source_url) — the regeneration target when ops drift stale. Ops are a cache OF this; the oracle lives in must[] (ADR tap-core 2026-07-25-plan-v3-clean-break).",
      "required": [
        "goal"
      ],
      "additionalProperties": false,
      "properties": {
        "goal": {
          "type": "string",
          "description": "The user's intent in natural language. Supersedes flat source_intent."
        },
        "source_url": {
          "type": "string"
        }
      }
    },
    "FlowCommon": {
      "type": "object",
      "description": "Fields shared by read and write Flow variants. NOT directly instantiable — use FlowRead or FlowWrite.",
      "required": [
        "id",
        "return"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "description": "Self-declared schema URL for forward-compatibility (per ADR tap-core 2026-05-09-userspace-via-standards.md INV-2)."
        },
        "id": {
          "$ref": "#/$defs/TapId"
        },
        "description": {
          "type": "string"
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ArgSpec"
          }
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runtime": {
              "enum": [
                "extension",
                "playwright",
                "macos-bridge"
              ]
            }
          }
        },
        "lifecycle": {
          "$ref": "#/$defs/FlowLifecycle"
        },
        "observe": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Op"
          }
        },
        "return": {
          "$ref": "#/$defs/CelExpr"
        },
        "source_url": {
          "type": "string"
        },
        "source_intent": {
          "type": "string"
        },
        "intent": {
          "$ref": "#/$defs/FlowIntent"
        },
        "must": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MustClause"
          }
        }
      }
    },
    "MustClause": {
      "type": "object",
      "description": "One authored predicate obligation — THE plan-level oracle spelling (ADR tap-core 2026-07-25-plan-v3-clean-break). Writes author post_act (the pre-act flip probe is derived from the same holds + the confirm channel); reads author post_return over the outcome contract.",
      "required": [
        "moment",
        "holds"
      ],
      "additionalProperties": false,
      "properties": {
        "moment": {
          "type": "string",
          "enum": [
            "pre_act",
            "post_act",
            "post_return"
          ]
        },
        "holds": {
          "$ref": "#/$defs/CelExpr"
        }
      }
    },
    "FlowRead": {
      "allOf": [
        {
          "$ref": "#/$defs/FlowCommon"
        },
        {
          "type": "object",
          "description": "Read variant — write fields are forbidden. The TS discriminated union uses `never` for these; JSON Schema expresses absence via `not`.",
          "not": {
            "anyOf": [
              {
                "required": [
                  "act"
                ]
              },
              {
                "required": [
                  "key"
                ]
              },
              {
                "required": [
                  "confirm"
                ]
              },
              {
                "required": [
                  "dedup_ttl_seconds"
                ]
              }
            ]
          }
        }
      ]
    },
    "FlowWrite": {
      "allOf": [
        {
          "$ref": "#/$defs/FlowCommon"
        },
        {
          "type": "object",
          "description": "Write variant — `act` and `key` are both required (key authored in product-semantic space, drives intent_key for at-most-once).",
          "required": [
            "act",
            "key"
          ],
          "properties": {
            "act": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Op"
              },
              "minItems": 1
            },
            "key": {
              "$ref": "#/$defs/CelExpr"
            },
            "confirm": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Op"
              }
            },
            "dedup_ttl_seconds": {
              "type": "number"
            }
          }
        }
      ]
    }
  }
}
