{
  "manifest_version": 3,
  "name": "Tap — Local-First Browser MCP",
  "version": "0.20.4",
  "key": "",
  "description": "Capture a logged-in browser task once; replay it forever at zero LLM tokens. Local-first, runs in your own Chrome.",
  "homepage_url": "https://taprun.dev/install?utm_source=chromewebstore&utm_medium=extension",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "nativeMessaging",
    "debugger",
    "activeTab",
    "tabs",
    "tabGroups",
    "bookmarks",
    "scripting",
    "cookies",
    "storage",
    "downloads",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": ["<all_urls>"]
  },
  "minimum_chrome_version": "116"
}
