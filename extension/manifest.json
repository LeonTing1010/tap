{
  "manifest_version": 3,
  "name": "Tap",
  "version": "0.4.0",
  "description": "AI browser automation runtime. Programs beat prompts — deterministic replay at zero AI cost.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "debugger",
    "activeTab",
    "tabs",
    "scripting",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": ["<all_urls>"]
  },
  "minimum_chrome_version": "116"
}
